install=""
subpackages=""
_commit="350f08fb2dda392253d07a488c65518088aeedbd"
source="
	30-initramfs-firmware.files
	$pkgname-$_commit.tar.gz::https://github.com/Vanilla-s-Android-Stuff/$pkgname/archive/$_commit.tar.gz
"
builddir="$srcdir/$pkgname-$_commit"

package() {
	mkdir -p "$pkgdir"
	find -type f -exec install -Dm 644 "{}" "$pkgdir/{}" \;

	install -Dm644 "$srcdir/30-initramfs-firmware.files" -t \
		"$pkgdir"/usr/share/mkinitfs/files
}

